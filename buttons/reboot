#!/bin/sh

[ "$ACTION" = "pressed" ] || exit 0

PIDFILE=/var/run/ix4-lcd.pid

if [ -r "$PIDFILE" ]; then
    read -r pid < "$PIDFILE"
    case "$pid" in
        ''|*[!0-9]*) ;;
        *) kill -USR2 "$pid" 2>/dev/null ;;
    esac
fi

sleep 5

logger -t ix4-lcd "Power button: starting system poweroff"
echo 0 > /sys/class/hwmon/hwmon0/device/pwm3 2>/dev/null
sync
poweroff
